# Salin ke .env.local (pengembangan) atau .env.production.local (server), lalu isi.
# Jangan pernah commit berkas .env yang berisi nilai asli.

# Koneksi MySQL. Format: mysql://user:password@host:port/database
DATABASE_URL=mysql://portfolio:ganti-kata-sandi@127.0.0.1:3306/ngiliyun_portfolio

# URL publik situs, dipakai untuk callback OAuth dan tautan berbagi.
SITE_URL=http://localhost:3000

# Login GitHub (buat OAuth App di https://github.com/settings/developers).
# Authorization callback URL: <SITE_URL>/admin/auth/github/callback/  (dengan garis miring di akhir)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Hanya akun GitHub ini yang boleh masuk CMS.
GITHUB_ALLOWED_LOGIN=ahmadngiliyun00

# Folder penyimpanan berkas unggahan (di luar public/). Relatif terhadap akar proyek atau path absolut.
UPLOAD_DIR=storage/uploads

# Form kontak. Pesan selalu tersimpan di CMS (/admin/pesan/). Isi SMTP supaya pesan baru
# juga diteruskan ke email; kosongkan untuk menonaktifkan penerusan.
# Contoh Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=alamat Gmail,
# SMTP_PASS=sandi aplikasi 16 huruf (bukan kata sandi akun), MAIL_FROM sama dengan SMTP_USER.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Alamat penerima notifikasi pesan baru.
CONTACT_TO=ahmad@ngiliyun.my.id
# Garam untuk hash alamat IP pengirim (isi teks acak panjang).
CONTACT_IP_SALT=

# Cloudflare Turnstile (opsional, anti robot). Buat widget di dasbor Cloudflare, menu Turnstile.
# Kosongkan keduanya untuk menonaktifkan; form tetap dilindungi kolom jebakan dan batas per IP.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
