# Salin ke .env.local (pengembangan) atau .env.production.local (server), lalu isi.
# Jangan pernah commit berkas .env yang berisi nilai asli.

# Koneksi MySQL. Format: mysql://user:password@host:port/database
DATABASE_URL=mysql://portfolio:ganti-kata-sandi@127.0.0.1:3306/ngiliyun_portfolio

# URL publik situs, dipakai untuk callback OAuth dan tautan berbagi.
SITE_URL=http://localhost:3000

# Login GitHub (buat OAuth App di https://github.com/settings/developers).
# Authorization callback URL: <SITE_URL>/admin/auth/github/callback/  (dengan garis miring di akhir)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Hanya akun GitHub ini yang boleh masuk CMS.
GITHUB_ALLOWED_LOGIN=ahmadngiliyun00

# Folder penyimpanan berkas unggahan (di luar public/). Relatif terhadap akar proyek atau path absolut.
UPLOAD_DIR=storage/uploads

# Form kontak. Pesan selalu tersimpan di CMS (/admin/pesan/). SMTP untuk meneruskan pesan ke
# email diatur di CMS (Pengaturan, Email dan SMTP), bukan di berkas ini.
# Garam untuk hash alamat IP pengirim (isi teks acak panjang).
CONTACT_IP_SALT=

# Cloudflare Turnstile (opsional, anti robot). Buat widget di dasbor Cloudflare, menu Turnstile.
# Kosongkan keduanya untuk menonaktifkan; form tetap dilindungi kolom jebakan dan batas per IP.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Media sosial: tarikan lewat API Meta TIDAK dipakai. Aplikasi Meta baru diarahkan ke Unified login yang
# mewajibkan portofolio bisnis, dan Instagram Login tidak lagi tersedia untuk aplikasi baru. Biarkan empat
# variabel di bawah kosong; postingan dimasukkan lewat impor ZIP ekspor data (docs/DEPLOY.md bagian 9).
# Hanya untuk aplikasi Meta yang masih punya akses: lampiran di docs/DEPLOY.md bagian 9.
# Redirect URL: <SITE_URL>/admin/auth/instagram/callback/ dan <SITE_URL>/admin/auth/facebook/callback/
# Kosongkan pasangan ID dan rahasia untuk mematikan platform itu. Token akun dienkripsi dengan kunci
# yang diturunkan dari rahasia aplikasi, jadi mengganti rahasia berarti menghubungkan ulang akun.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Versi Graph API (opsional, bawaan v24.0).
META_GRAPH_VERSION=
# Rahasia untuk tarikan terjadwal POST /cron/social/ (minimal 32 karakter, misalnya openssl rand -hex 32).
# Kosong berarti rute cron mati; postingan tetap bisa ditarik lewat tombol di CMS.
SOCIAL_CRON_SECRET=
